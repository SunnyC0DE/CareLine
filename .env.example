# Providers: groq|gemini, deepgram|groq, piper|groq
LLM_PROVIDER=groq
STT_PROVIDER=deepgram
TTS_PROVIDER=piper

# Create keys only for the selected hosted providers. Never commit .env.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=

# Provider models
GROQ_LLM_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.8-flash
DEEPGRAM_MODEL=nova-3-general
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
PIPER_VOICE=en_US-lessac-medium

# Clinic demo configuration (replace all values for your clinic)
CLINIC_NAME=Willowbend Family Clinic
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_OPEN_TIME=09:00
CLINIC_CLOSE_TIME=17:00
CLINIC_LUNCH_START=12:00
CLINIC_LUNCH_END=13:00
APPOINTMENT_MINUTES=30
WORKING_DAYS=0,1,2,3,4

# Runtime/data
PORT=3000
CARELINE_DB_PATH=data/careline.sqlite3
LOG_LEVEL=INFO
