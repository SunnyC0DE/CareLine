{
  "include": ["backend", "tests", "eval"],
  "exclude": ["**/__pycache__", "**/.pytest_cache", "web/node_modules", ".venv"],
  "venvPath": ".",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [".", ".venv/lib/python3.12/site-packages"]
    }
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "reportMissingTypeStubs": false
}
